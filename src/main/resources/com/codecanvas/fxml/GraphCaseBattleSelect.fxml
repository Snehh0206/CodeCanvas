<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codecanvas.controller.GraphCaseBattleSelectController">
    <children>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <Button text="← Back" onAction="#handleBack" />
                <Button text="Dashboard" onAction="#handleDashboard" />
            </children>
        </HBox>
        <Label text="Algorithm A" />
        <ComboBox fx:id="algorithmAComboBox" />
        <ComboBox fx:id="caseAComboBox" />
        <Label text="Algorithm B" />
        <ComboBox fx:id="algorithmBComboBox" />
        <ComboBox fx:id="caseBComboBox" />
        <Label text="Vertex Count" />
        <TextField fx:id="vertexCountField" promptText="e.g. 8" />
        <Button text="Start Battle" onAction="#handleStartBattle" />
    </children>
    <padding><Insets top="20.0" right="20.0" bottom="20.0" left="20.0" /></padding>
</VBox>