<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codecanvas.controller.RaceModeController">

    <top>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <padding><Insets top="12.0" right="16.0" bottom="6.0" left="16.0" /></padding>
            <children>
                <Button text="← Back" onAction="#handleBack" />
                <Button text="Dashboard" onAction="#handleDashboard" />
                <Label text="Race Mode" styleClass="welcome-title" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="sourceInstructionLabel" text="" styleClass="subtitle" />
                <Button fx:id="startRaceButton" text="Start Race" onAction="#handleStartRaceClick" visible="false" managed="false" />
            </children>
        </HBox>
    </top>

    <center>
        <ScrollPane styleClass="edge-to-edge" fitToWidth="true">
            <content>
                <HBox spacing="16.0">
                    <padding><Insets top="6.0" right="16.0" bottom="6.0" left="16.0" /></padding>
                    <children>

                        <VBox styleClass="card" spacing="8.0" alignment="TOP_CENTER" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <children>
                                <Label fx:id="algorithm1NameLabel" text="Algorithm 1" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                                <Pane fx:id="visualizationPane1" prefWidth="420.0" prefHeight="320.0" minHeight="320.0" maxWidth="420.0" />
                                <Label fx:id="stats1Label" text="Comparisons: 0 | Swaps: 0" />
                                <Label fx:id="timeComplexity1Label" text="Complexity: -" />
                                <Label fx:id="executionTime1Label" text="Time: -" />
                                <Label fx:id="thread1Label" text="Thread: -" styleClass="subtitle" />
                                <ProgressBar fx:id="progress1Bar" progress="0.0" maxWidth="Infinity" />
                                <VBox fx:id="distanceTracker1Box" spacing="2.0" />
                            </children>
                        </VBox>

                        <VBox styleClass="card" spacing="8.0" alignment="TOP_CENTER" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <children>
                                <Label fx:id="algorithm2NameLabel" text="Algorithm 2" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                                <Pane fx:id="visualizationPane2" prefWidth="420.0" prefHeight="320.0" minHeight="320.0" maxWidth="420.0" />
                                <Label fx:id="stats2Label" text="Comparisons: 0 | Swaps: 0" />
                                <Label fx:id="timeComplexity2Label" text="Complexity: -" />
                                <Label fx:id="executionTime2Label" text="Time: -" />
                                <Label fx:id="thread2Label" text="Thread: -" styleClass="subtitle" />
                                <ProgressBar fx:id="progress2Bar" progress="0.0" maxWidth="Infinity" />
                                <VBox fx:id="distanceTracker2Box" spacing="2.0" />
                            </children>
                        </VBox>

                    </children>
                </HBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <Label fx:id="resultLabel" text="" styleClass="banner" alignment="CENTER" maxWidth="Infinity">
            <BorderPane.margin><Insets top="6.0" right="16.0" bottom="14.0" left="16.0" /></BorderPane.margin>
        </Label>
    </bottom>

</BorderPane>