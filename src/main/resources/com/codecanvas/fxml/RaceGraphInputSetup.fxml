<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codecanvas.controller.RaceGraphInputSetupController">

    <top>
        <HBox spacing="10.0" alignment="TOP_LEFT">
            <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0" /></padding>
            <children>
                <Button text="← Back" onAction="#handleBack" />
                <Button text="Dashboard" onAction="#handleDashboard" />
            </children>
        </HBox>
    </top>

    <center>
        <VBox spacing="10.0" alignment="CENTER" maxWidth="420.0">
            <children>
                <Button text="Example Graph" onAction="#handleExampleGraph" />
                <Button text="Custom Graph" onAction="#handleCustomGraphToggle" />
                <TextField fx:id="vertexCountField" promptText="Shared vertex count, e.g. 5" disable="true" />
                <Label text="Edges format: u-v-w (vertex-vertex-weight)" />
                <TextField fx:id="edgeCount1Field" promptText="Edge count A" disable="true" />
                <TextField fx:id="edges1Field" promptText="Edges A, e.g. 0-1-4,0-2-1" disable="true" />
                <TextField fx:id="edgeCount2Field" promptText="Edge count B" disable="true" />
                <TextField fx:id="edges2Field" promptText="Edges B, e.g. 0-1-2,1-2-3" disable="true" />
                <Button text="Continue" onAction="#handleContinue" />
            </children>
        </VBox>
    </center>

</BorderPane>