<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codecanvas.controller.QuizModeController">

    <top>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <padding><Insets top="12.0" right="16.0" bottom="6.0" left="16.0" /></padding>
            <children>
                <Button text="← Back" onAction="#handleBack" />
                <Button text="Dashboard" onAction="#handleDashboard" />
                <Label text="Quiz Mode" styleClass="welcome-title" />
            </children>
        </HBox>
    </top>

    <center>
        <StackPane>
            <children>
                <VBox styleClass="card" spacing="12.0" alignment="TOP_CENTER" maxWidth="640.0" maxHeight="-Infinity">
                    <padding><Insets top="24.0" right="24.0" bottom="24.0" left="24.0" /></padding>
                    <children>
                        <HBox spacing="10.0" alignment="CENTER">
                            <children>
                                <ComboBox fx:id="algorithmComboBox" promptText="Choose an algorithm" prefWidth="240.0" />
                                <Button text="Start Quiz" onAction="#handleStartQuiz" />
                            </children>
                        </HBox>
                        <Label fx:id="sourceLabel" text="" styleClass="subtitle" wrapText="true" />
                        <Label fx:id="progressLabel" text="" styleClass="card-title" />
                        <Label fx:id="questionLabel" text="Pick an algorithm and press Start Quiz" wrapText="true"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                        <VBox fx:id="optionsBox" spacing="10.0" alignment="CENTER_LEFT" />
                        <Button fx:id="submitButton" text="Submit answer" onAction="#handleSubmit" visible="false" managed="false" />
                        <Label fx:id="feedbackLabel" text="" styleClass="banner" wrapText="true" maxWidth="Infinity" visible="false" managed="false" />
                        <Label fx:id="scoreLabel" text="" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>

</BorderPane>