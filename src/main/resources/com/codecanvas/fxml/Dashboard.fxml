<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.geometry.Insets?>
        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.layout.BorderPane?>
        <?import javafx.scene.layout.VBox?>

<BorderPane
        maxHeight="-Infinity"
        maxWidth="-Infinity"
        minHeight="-Infinity"
        minWidth="-Infinity"
        prefHeight="600.0"
        prefWidth="1000.0"
        styleClass="dashboard"
        stylesheets="@../css/style.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.codecanvas.controller.DashboardController">

   <!-- TOP -->
   <top>
      <VBox
              alignment="CENTER_LEFT"
              spacing="4.0"
              styleClass="header">

         <padding>
            <Insets top="22.0" right="30.0" bottom="22.0" left="30.0"/>
         </padding>

         <children>
            <Label
                    text="CODECANVAS"
                    styleClass="title"/>

            <Label
                    text="INTERACTIVE ALGORITHM LEARNING SYSTEM"
                    styleClass="subtitle"/>
         </children>
      </VBox>
   </top>

   <!-- LEFT MENU -->
   <left>
      <VBox
              prefWidth="210.0"
              spacing="8.0"
              styleClass="sidebar">

         <padding>
            <Insets top="28.0" right="20.0" bottom="28.0" left="20.0"/>
         </padding>

         <children>

            <Label
                    text="MAIN MENU"
                    styleClass="section-label"/>

            <Button
                    fx:id="algorithmLabButton"
                    maxWidth="1.7976931348623157E308"
                    mnemonicParsing="false"
                    onAction="#handleAlgorithmLab"
                    prefHeight="40.0"
                    text="Algorithm Lab"
                    styleClass="active-button"/>

            <Button
                    fx:id="raceModeButton"
                    maxWidth="1.7976931348623157E308"
                    mnemonicParsing="false"
                    onAction="#handleRaceMode"
                    prefHeight="40.0"
                    text="Race Mode"
                    styleClass="menu-button"/>

            <Button
                    fx:id="quizButton"
                    maxWidth="1.7976931348623157E308"
                    mnemonicParsing="false"
                    onAction="#handleQuiz"
                    prefHeight="40.0"
                    text="Quiz"
                    styleClass="menu-button"/>

            <Button
                    fx:id="historyButton"
                    maxWidth="1.7976931348623157E308"
                    mnemonicParsing="false"
                    onAction="#handleHistory"
                    prefHeight="40.0"
                    text="History"
                    styleClass="menu-button"/>

            <Button
                    fx:id="statisticsButton"
                    maxWidth="1.7976931348623157E308"
                    mnemonicParsing="false"
                    onAction="#handleStatistics"
                    prefHeight="40.0"
                    text="Statistics"
                    styleClass="menu-button"/>

            <Button
                    fx:id="masteryMapButton"
                    maxWidth="1.7976931348623157E308"
                    mnemonicParsing="false"
                    onAction="#handleMasteryMap"
                    prefHeight="40.0"
                    text="Mastery Map"
                    styleClass="menu-button"/>

            <Button
                    fx:id="settingsButton"
                    maxWidth="1.7976931348623157E308"
                    mnemonicParsing="false"
                    onAction="#handleSettings"
                    prefHeight="40.0"
                    text="Settings"
                    styleClass="menu-button"/>

         </children>
      </VBox>
   </left>

   <!-- CENTER -->
   <center>
      <VBox
              alignment="TOP_LEFT"
              spacing="20.0"
              styleClass="content">

         <padding>
            <Insets top="40.0" right="45.0" bottom="40.0" left="45.0"/>
         </padding>

         <children>

            <Label
                    text="WELCOME BACK, USER_"
                    styleClass="heading"/>

            <Label
                    text="Ready to experiment with algorithms?"
                    styleClass="description"/>

            <VBox
                    prefWidth="600.0"
                    spacing="14.0"
                    styleClass="stats-card">

               <padding>
                  <Insets top="22.0" right="25.0" bottom="22.0" left="25.0"/>
               </padding>

               <children>

                  <Label
                          fx:id="experimentCountLabel"
                          maxWidth="1.7976931348623157E308"
                          text="Experiments"
                          styleClass="stat"/>

                  <Label
                          fx:id="recentAlgorithmLabel"
                          maxWidth="1.7976931348623157E308"
                          text="Recent Algorithm"
                          styleClass="stat"/>

                  <Label
                          fx:id="quizScoreLabel"
                          maxWidth="1.7976931348623157E308"
                          text="Quiz Score"
                          styleClass="stat"/>

                  <Label
                          fx:id="savedRunsLabel"
                          maxWidth="1.7976931348623157E308"
                          text="Saved Runs"
                          styleClass="stat"/>

                  <Label
                          fx:id="recentActivityLabel"
                          maxWidth="1.7976931348623157E308"
                          text="Recent Activity"
                          styleClass="stat"/>

               </children>
            </VBox>

         </children>
      </VBox>
   </center>

</BorderPane>

