<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codecanvas.controller.DashboardController">

   <left>
      <VBox styleClass="sidebar" prefWidth="220.0" spacing="4.0">
         <padding><Insets top="24.0" right="12.0" bottom="20.0" left="12.0" /></padding>
         <children>
            <Label text="CodeCanvas" styleClass="app-title" />
            <Region prefHeight="16.0" />
            <Button text="Algorithm Lab" styleClass="nav-button" maxWidth="Infinity" onAction="#handleAlgorithmLab" />
            <Button text="Race Mode" styleClass="nav-button" maxWidth="Infinity" onAction="#handleRaceMode" />
            <Button text="Quiz Mode" styleClass="nav-button" maxWidth="Infinity" onAction="#handleQuiz" />
            <Button text="History" styleClass="nav-button" maxWidth="Infinity" onAction="#handleHistory" />
            <Button text="Statistics" styleClass="nav-button" maxWidth="Infinity" onAction="#handleStatistics" />
            <Button text="Mastery Map" styleClass="nav-button" maxWidth="Infinity" onAction="#handleMasteryMap" />
            <Button text="Settings" styleClass="nav-button" maxWidth="Infinity" onAction="#handleSettings" />
            <Region VBox.vgrow="ALWAYS" />
            <Button text="Logout" styleClass="nav-button" maxWidth="Infinity" onAction="#handleLogout" />
         </children>
      </VBox>
   </left>

   <center>
      <ScrollPane fitToWidth="true" BorderPane.alignment="CENTER">
         <content>
            <VBox spacing="20.0">
               <padding><Insets top="24.0" right="28.0" bottom="24.0" left="28.0" /></padding>
               <children>

                  <VBox spacing="2.0">
                     <children>
                        <Label fx:id="welcomeLabel" text="Welcome back!" styleClass="welcome-title" />
                        <Label text="Here is your learning progress at a glance" styleClass="subtitle" />
                     </children>
                  </VBox>

                  <HBox spacing="16.0">
                     <children>
                        <VBox styleClass="card" spacing="6.0" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                           <children>
                              <Label text="EXPERIMENTS" styleClass="card-title" />
                              <Label fx:id="experimentCountLabel" text="0" styleClass="card-value" />
                           </children>
                        </VBox>
                        <VBox styleClass="card" spacing="6.0" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                           <children>
                              <Label text="RECENT ALGORITHM" styleClass="card-title" />
                              <Label fx:id="recentAlgorithmLabel" text="-" styleClass="card-value" wrapText="true" />
                           </children>
                        </VBox>
                        <VBox styleClass="card" spacing="6.0" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                           <children>
                              <Label text="QUIZ SCORE" styleClass="card-title" />
                              <Label fx:id="quizScoreLabel" text="0/0" styleClass="card-value" />
                           </children>
                        </VBox>
                        <VBox styleClass="card" spacing="6.0" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                           <children>
                              <Label text="QUIZ ACCURACY" styleClass="card-title" />
                              <Label fx:id="accuracyLabel" text="0%" styleClass="card-value" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <HBox spacing="16.0">
                     <children>
                        <VBox styleClass="card" spacing="8.0" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                           <children>
                              <Label text="RECENT ACTIVITY" styleClass="card-title" />
                              <VBox fx:id="recentActivityBox" spacing="2.0" />
                           </children>
                        </VBox>
                        <VBox styleClass="card" spacing="10.0" prefWidth="280.0">
                           <children>
                              <Label text="QUICK START" styleClass="card-title" />
                              <Button text="Open Algorithm Lab" maxWidth="Infinity" onAction="#handleAlgorithmLab" />
                              <Button text="Start a Race" maxWidth="Infinity" onAction="#handleRaceMode" />
                              <Button text="Take a Quiz" maxWidth="Infinity" onAction="#handleQuiz" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>

</BorderPane>