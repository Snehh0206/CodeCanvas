<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codecanvas.controller.RaceAlgorithmSelectController">
    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0" />
    </padding>
    <children>
        <Label text="Pick Algorithm 1" />
        <ComboBox fx:id="algorithm1ComboBox" prefWidth="200.0" />
        <Label text="Pick Algorithm 2" />
        <ComboBox fx:id="algorithm2ComboBox" prefWidth="200.0" />
        <Button fx:id="continueButton" text="Continue" onAction="#handleContinue" prefWidth="200.0" />
    </children>
</VBox>