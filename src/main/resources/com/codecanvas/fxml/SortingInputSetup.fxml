<?xml version="1.0" encoding="UTF-8"?>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codecanvas.controller.SortingInputSetupController">

    <top>
        <HBox spacing="10.0" alignment="TOP_LEFT">
            <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0" /></padding>
            <children>
                <Button text="← Back" onAction="#handleBack" />
                <Button text="Dashboard" onAction="#handleDashboard" />
            </children>
        </HBox>
    </top>

    <center>
        <StackPane>
        <children>
        <VBox styleClass="card" spacing="12.0" alignment="CENTER" maxWidth="380.0" maxHeight="-Infinity">
            <padding><Insets top="24.0" right="24.0" bottom="24.0" left="24.0" /></padding>
            <children>
                <Label text="Set up your input" styleClass="welcome-title" style="-fx-font-size: 20px;" />
                <Label text="Use example data, type your own, or fetch live data" styleClass="subtitle" wrapText="true" />
                <Button text="Example Input" onAction="#handleExampleInput" />
                <Button text="Custom Input" onAction="#handleCustomInput" />
                <Button text="Fetch Live Data (API)" onAction="#handleFetchLiveData" />
                <TextField fx:id="customInputField" promptText="e.g. 5,2,9,1" disable="true" />
                <CheckBox fx:id="quizModeCheckBox" text="Quiz Mode" />
                <Button text="Continue" onAction="#handleContinue" />
            </children>
        </VBox>
        </children>
        </StackPane>
    </center>

</BorderPane>