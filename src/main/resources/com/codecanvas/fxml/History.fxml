<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codecanvas.controller.HistoryController">

    <top>
        <HBox spacing="10.0" BorderPane.alignment="CENTER_LEFT">
            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
            </padding>
            <children>
                <Button text="← Back" onAction="#handleBack" />
                <Button text="Dashboard" onAction="#handleDashboard" />
                <Button text="Refresh" onAction="#handleRefresh" />
                <Button text="Delete Selected" onAction="#handleDelete" />
            </children>
        </HBox>
    </top>

    <center>
        <TableView fx:id="historyTable" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" />
                <TableColumn fx:id="algorithmColumn" text="Algorithm" />
                <TableColumn fx:id="caseTypeColumn" text="Case" />
                <TableColumn fx:id="inputSizeColumn" text="Input Size" />
                <TableColumn fx:id="stepsColumn" text="Steps" />
                <TableColumn fx:id="comparisonsColumn" text="Comparisons" />
                <TableColumn fx:id="swapsColumn" text="Swaps" />
                <TableColumn fx:id="timeColumn" text="Time (µs)" />
                <TableColumn fx:id="dateColumn" text="Date" />
            </columns>
        </TableView>
    </center>

</BorderPane>