<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codecanvas.controller.MasteryMapController">
    <children>
        <HBox spacing="10.0">
            <children>
                <Button text="← Back" onAction="#handleBack" />
                <Button text="Dashboard" onAction="#handleDashboard" />
            </children>
        </HBox>
        <Label text="Your Algorithm Mastery" style="-fx-font-size: 18px;" />

        <Label fx:id="insertionSortLabel" text="Insertion Sort" />
        <ProgressBar fx:id="insertionSortBar" prefWidth="400.0" progress="0.0" />

        <Label fx:id="quickSortLabel" text="Quick Sort" />
        <ProgressBar fx:id="quickSortBar" prefWidth="400.0" progress="0.0" />

        <Label fx:id="dijkstraLabel" text="Dijkstra" />
        <ProgressBar fx:id="dijkstraBar" prefWidth="400.0" progress="0.0" />

        <Label fx:id="bellmanFordLabel" text="Bellman-Ford" />
        <ProgressBar fx:id="bellmanFordBar" prefWidth="400.0" progress="0.0" />
    </children>
    <padding><Insets top="20.0" right="20.0" bottom="20.0" left="20.0" /></padding>
</VBox>