<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codecanvas.controller.MasteryMapController">
    <children>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <Button text="← Back" onAction="#handleBack" />
                <Button text="Dashboard" onAction="#handleDashboard" />
                <Label text="Mastery Map" styleClass="welcome-title" />
            </children>
        </HBox>

        <VBox styleClass="card" spacing="12.0" VBox.vgrow="ALWAYS">
            <children>
                <Label fx:id="insertionSortLabel" text="Insertion Sort" />
                <ProgressBar fx:id="insertionSortBar" maxWidth="Infinity" progress="0.0" />

                <Label fx:id="quickSortLabel" text="Quick Sort" />
                <ProgressBar fx:id="quickSortBar" maxWidth="Infinity" progress="0.0" />

                <Label fx:id="dijkstraLabel" text="Dijkstra" />
                <ProgressBar fx:id="dijkstraBar" maxWidth="Infinity" progress="0.0" />

                <Label fx:id="bellmanFordLabel" text="Bellman-Ford" />
                <ProgressBar fx:id="bellmanFordBar" maxWidth="Infinity" progress="0.0" />
            </children>
        </VBox>
    </children>
    <padding><Insets top="20.0" right="20.0" bottom="20.0" left="20.0" /></padding>
</VBox>