<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codecanvas.controller.AlgorithmSelectController">
    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0" />
    </padding>
    <children>
        <Label text="Choose an Algorithm" style="-fx-font-size: 22px;" />
        <Button fx:id="insertionSortButton" text="Insertion Sort" onAction="#handleInsertionSort" prefWidth="200.0" />
        <Button fx:id="quickSortButton" text="Quick Sort" onAction="#handleQuickSort" prefWidth="200.0" />
        <Button fx:id="dijkstraButton" text="Dijkstra" onAction="#handleDijkstra" prefWidth="200.0" />
        <Button fx:id="bellmanFordButton" text="Bellman-Ford" onAction="#handleBellmanFord" prefWidth="200.0" />
    </children>
</VBox>