<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codecanvas.controller.RaceModeSelectController">
    <children>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <Button text="← Back" onAction="#handleBack" />
                <Button text="Dashboard" onAction="#handleDashboard" />
            </children>
        </HBox>
        <Label text="Choose Race Type" />
        <Button fx:id="userInputButton" text="User Input Race" onAction="#handleUserInput" />
        <Button fx:id="caseBattleButton" text="Case Battle" onAction="#handleCaseBattle" />
    </children>
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>
</VBox>